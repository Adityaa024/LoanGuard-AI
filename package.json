{
  "name": "the-hive",
  "version": "1.0.0",
  "description": "THE HIVE — a live governance layer for swarms of autonomous AI agents.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "node data/generate.js",
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "build:web": "cd web && npm install && npm run build",
    "build": "bash -c '[ -f web/package.json ] && (cd web && npm install && npm run build) || echo \"[build] no web/ yet — serving placeholder\"'",
    "postinstall": "node data/generate.js || true",
    "test": "HIVE_NO_OVERLAY=1 node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "csv-parse": "^7.0.2",
    "dompurify": "^3.4.14",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "sharp": "^0.33.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "yaml": "^2.6.1",
    "zod": "^4.5.4"
  }
}
